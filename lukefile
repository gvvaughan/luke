luke_format = 0

package  = 'luke'
version  = '$USER/$gitref'

-- A build without help2man keeps the man page that a release commits.
variables = {
   HELP2MAN = {checkprog='HELP2MAN', progs={'help2man', 'true'}},
}

modules  = {
   {['luke']                 = 'lib/luke/init.lua'},
   {['luke._base']           = 'lib/luke/_base.lua'},
   {['luke.cli']             = 'lib/luke/cli.lua'},
   {['luke.compile']         = 'lib/luke/compile.lua'},
   {['luke.configure']       = 'lib/luke/configure.lua'},
   {['luke.environment']     = 'lib/luke/environment.lua'},
   {['luke.functional']      = 'lib/luke/functional.lua'},
   {['luke.lukefile']        = 'lib/luke/lukefile.lua'},
   {['luke.normalize']       = 'lib/luke/normalize.lua'},
   {['luke.platforms']       = 'lib/luke/platforms.lua'},
   {['luke.prepare']         = 'lib/luke/prepare.lua'},
   {['luke.release']         = 'lib/luke/release.lua'},
   {['luke.schema']          = 'lib/luke/schema.lua'},
   {['luke.version']         = 'lib/luke/version.lua.in'},
   {['type.context-manager'] = 'lib/type/context-manager.lua'},
   {['type.dict']            = 'lib/type/dict.lua'},
   {['type.path']            = 'lib/type/path.lua'},
}

-- build-aux/luke, the single-file copy of luke that projects vendor,
-- bundles every module above.
local bundled = {
   'lib/luke/_base.lua',
   'lib/luke/cli.lua',
   'lib/luke/compile.lua',
   'lib/luke/configure.lua',
   'lib/luke/environment.lua',
   'lib/luke/functional.lua',
   'lib/luke/init.lua',
   'lib/luke/lukefile.lua',
   'lib/luke/normalize.lua',
   'lib/luke/platforms.lua',
   'lib/luke/prepare.lua',
   'lib/luke/release.lua',
   'lib/luke/schema.lua',
   'lib/luke/version.lua.in',
   'lib/type/context-manager.lua',
   'lib/type/dict.lua',
   'lib/type/path.lua',
}

bin = {
   {['build-aux/luke'] = {
      command = '$LUA build-aux/smush $sources > $target',
      env = {
         LUA_PATH = '$abs_top_srcdir/lib/?.lua;$abs_top_srcdir/lib/?/init.lua;;',
      },
      sources = bundled,
   }},
}

-- Document build-aux/luke, the luke that projects vendor and LuaRocks installs.
files = {
   {['doc/luke.1'] = {
      command = '$HELP2MAN --output=$target --no-info --name="Use the source, Luke!" "$LUA build-aux/luke"',
      sources = 'build-aux/luke',
   }},
}

-- `luke release version=X.Y` adds the release to NEWS.md, writes the
-- release rockspec, points the README badges at the release branch,
-- commits the man page, and publishes the manual to gh-pages.
release = {
   news         = 'NEWS.md',
   rockspec     = 'luke-dev-1.rockspec',
   replacements = {
      {['README.md'] = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages'] = {
      {['index.md'] = 'doc/luke.md'},
      '_config.yml.in',
   },
}
